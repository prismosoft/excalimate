# Shared by API and render worker
DATABASE_URL=postgresql://...
RENDER_QUEUE=excalimate-render
RENDER_JOB_TIMEOUT_SECONDS=3600
RENDER_HEARTBEAT_SECONDS=60
RENDER_RETRY_LIMIT=2

# Railway Storage Bucket (S3-compatible)
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
ENDPOINT=
# Usually false for Railway Storage Buckets. Set true only if your S3 endpoint
# requires path-style requests.
BUCKET_FORCE_PATH_STYLE=false

# API service
SERVICE_API_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://api.example.com

# OAuth 2.1 for ChatGPT / user-facing MCP clients.
# Keep these separate from SERVICE_API_KEY.
OAUTH_LOGIN_PASSWORD=replace-with-a-strong-operator-password
OAUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_SESSION_TTL_SECONDS=2592000
PG_POOL_MAX=5
PGBOSS_POOL_MAX=4
MAX_IMAGE_BYTES=4194304
MCP_MAX_STRING_LENGTH=8388608
MCP_MAX_STATE_BYTES=20971520
# Temporary animation working state cleanup. Set TTL to 0 to disable.
TEMP_PROJECT_TTL_HOURS=24
PROJECT_CLEANUP_INTERVAL_MINUTES=15
PROJECT_CLEANUP_BATCH=50

# Render worker
# Prefer Railway private networking:
# http://excalimate-web.railway.internal:8080/render.html
RENDERER_URL=http://excalimate-web.railway.internal:8080/render.html
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_MS=1800000
PG_POOL_MAX=4
PGBOSS_POOL_MAX=6
